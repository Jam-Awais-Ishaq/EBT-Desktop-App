# Auth / profile (login, getProfile) — matches Vite dev proxy /api → this port
VITE_API_BASE_URL=http://127.0.0.1:3000

# Task + timer API (taskmanagment-backend) — must NOT go through Vite /api proxy
VITE_TASK_API_BASE_URL=http://127.0.0.1:5001

# Same cloud name as task backend CLOUD_NAME — builds screenshot URLs from DB public_id
VITE_CLOUDINARY_CLOUD_NAME=

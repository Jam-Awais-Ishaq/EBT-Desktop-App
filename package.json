{
  "name": "ebt-desktop",
  "private": true,
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdc-agency/gdc-desktop.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "npm run electron:dev",
    "electron:dev": "node scripts/electron-dev.cjs",
    "build": "vite build",
    "electron:start": "electron .",
    "electron:open": "npm run build && electron .",
    "electron:build": "node scripts/electron-release.cjs",
    "electron:publish": "node scripts/electron-release.cjs --publish",
    "electron:build:dir": "vite build && electron-builder --win --dir",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "koffi": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2",
    "redux-persist": "^6.0.0",
    "redux-persist-electron-storage": "^2.1.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^41.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.elevatebrighttec.desktop",
    "productName": "Elevate Bright Tec",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gdc-agency",
        "repo": "gdc-desktop"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true
    }
  }
}
